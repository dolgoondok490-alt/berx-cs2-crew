# BERX SKIN INVENTORY — agent синкийн ТУСДАА тохиргоо (agent/.env-ийг өөрчлөхгүй)
# Энэ файлыг "agent/.env.skins" нэрээр хуулж бөглө. ⚠️ GitHub-д бүү оруул (.gitignore-д орсон).
# Анхааруулга: skins/README.md болон skins/COMPATIBILITY.md-ийг уншиж, эрсдэлийг хүлээн зөвшөөрсний дараа л асаа.

# 1 = асаана. Анхдагч 0 (унтраалттай).
SKINS_SYNC_ENABLED=0

# Локал MariaDB/MySQL (зөвхөн 127.0.0.1 дээр сонсоно — 3306-г интернэтэд бүү нээ)
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_NAME=berx_weaponpaints
# Agent-д зориулсан хязгаарлагдмал хэрэглэгч (SELECT, INSERT, UPDATE, DELETE — DROP/ALTER эрхгүй)
WP_DB_USER=berx_agent
WP_DB_PASSWORD=

# Сайтаас шинэ loadout шалгах давтамж (мс)
SKINS_POLL_MS=10000
# 1 = тоглогч серверт байвал RCON "wp_refresh <steamid64>" илгээж шууд хэрэгжүүлнэ
SKINS_REFRESH=1
