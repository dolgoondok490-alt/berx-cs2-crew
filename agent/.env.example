# BERX Agent тохиргоо — энэ файлыг "agent/.env" нэрээр хуулж бөглө.
# ⚠️ agent/.env-г хэзээ ч GitHub-д бүү оруул (.gitignore-д орсон)

# Сайтын хаяг
BERX_URL=https://berx-cs2-crew.vercel.app

# Vercel дээрх SERVER_AGENT_SECRET-тэй ЯГ ИЖИЛ (24+ тэмдэгт)
SERVER_AGENT_SECRET=

# CS2 серверийн RCON (server.cfg доторх rcon_password-тэй ижил)
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=

# Найзууд холбогдох нийтийн хаяг: таны гадаад IP:27015 (https://api.ipify.org)
PUBLIC_ADDRESS=

# CS2 сервер суулгасан хавтас (доор нь game\csgo байна). Map серверт суусан эсэхийг эндээс шалгана.
# SteamCMD-ээр суулгасан бол ихэвчлэн: C:\cs2-server\steamcmd\steamapps\common\Counter-Strike Global Offensive
CS2_DIR=C:\cs2-server

# (Заавал биш) Серверт суугаагүй map-ыг Workshop-оос ачаалах ID. Cache 2026.04-өөс CS2-т албан ёсоор орсон тул
# CS2-оо шинэчилсэн бол ХЭРЭГГҮЙ. Жишээ: WORKSHOP_CACHE=1234567890
# WORKSHOP_CACHE=

# MatchZy event хүлээн авах локал порт (гадагш нээх хэрэггүй)
EVENTS_PORT=27050
POLL_MS=5000
MAX_PLAYERS=12

# Алдаа хайхдаа 1 болго
DEBUG=0

# (Заавал биш) Vercel Preview дээр тест хийхэд: BERX_URL=<preview хаяг> + Vercel → Settings → Deployment Protection →
# "Protection Bypass for Automation"-ийн secret. Production хаяг руу хэзээ ч илгээгдэхгүй.
# VERCEL_AUTOMATION_BYPASS_SECRET=
# (Заавал биш) AIM тохиргоо өөрчлөгдсөн эсэхийг шалгах давтамж (мс)
# ARENA_VERIFY_MS=30000
