# Локал: энэ файлыг ".env" нэрээр хуулж бөглө.  Vercel: Project → Settings → Environment Variables
# ⚠️ .env-г git-д хэзээ ч бүү оруул (.gitignore-д орсон)

# Урт санамсаргүй текст: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=             # нууц sb_secret_... — зөвхөн server (хуучин нэр SUPABASE_SERVICE_ROLE_KEY ч ажиллана)
SUPABASE_PUBLISHABLE_KEY=        # нийтийн (publishable / anon) — realtime-д browser ашиглана

# https://steamcommunity.com/dev/apikey  — nickname, avatar, "CS2 тоглож байна"
STEAM_API_KEY=
# https://developers.faceit.com → App → API Keys (Server side)
FACEIT_API_KEY=
# Leetify API key — Premier rating
LEETIFY_API_KEY=

# Admin эрх авах хүмүүс (таслалаар): имэйл, утас (99112233) эсвэл SteamID64
ADMIN_LOGINS=

# Заавал биш
# BASE_URL=https://berx.vercel.app        # хоосон бол автоматаар тодорхойлно
# ALLOWED_STEAM_IDS=7656119...,7656119... # зөвхөн эдгээр Steam данс нэвтэрнэ

# ---- SERVER (BERX ARENA) — CS2 сервер холбох ----
# Таны компьютер дээрх BERX Agent-тэй ИЖИЛ нууц түлхүүр (24+ тэмдэгт)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_AGENT_SECRET=
# Серверийн sv_password (заавал биш). Зөвхөн нэвтэрсэн гишүүдэд connect команд дотор харагдана
SERVER_PASSWORD=
