<Project Sdk="Microsoft.NET.Sdk">
  <!-- Серверийн CounterStrikeSharp 1.0.380 (net10.0)-тэй яг ижил API хувилбараар build хийнэ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BerxGuard</AssemblyName>
    <RootNamespace>BerxGuard</RootNamespace>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Сервер дээр аль хэдийн суусан → plugin хавтаст хуулахгүй (ExcludeAssets=runtime) -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.380" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
